# Database
DATABASE_URL=postgresql://spread:spread_dev@localhost:5432/spreadservice

# Redis
REDIS_URL=redis://localhost:6379

# Exchange API keys (можно оставить пустыми — движок будет работать в read-only)
MEXC_API_KEY=
MEXC_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
GATE_API_KEY=
GATE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Параметры
MIN_VOLUME_USD=5000000
MIN_NET_SPREAD_PCT=0.1
SCAN_INTERVAL_MS=5000
DB_WRITE_INTERVAL_MS=10000

# Окружение
NODE_ENV=development
LOG_LEVEL=debug
